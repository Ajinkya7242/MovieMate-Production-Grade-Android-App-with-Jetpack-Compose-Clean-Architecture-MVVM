      These XML colors are used by the system splash screen (Android 12+)
      and by the launcher icon. The Compose UI uses its own colors defined
      in core/theme/Color.kt.
    -->
    <color name="splash_background">#0E0E0E</color>
    <color name="ic_launcher_background">#E50914</color>
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
</resources>
